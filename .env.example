# Copy to .env and fill in. docker-compose reads this for secrets.
# cp .env.example .env

# --- Google OAuth 2.0 (README §2.1) ---------------------------------------
# Create an OAuth Client (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Session signing secret — change this.
SESSION_SECRET=dev-secret-change-me

# --- Database ---------------------------------------------------------------
# docker-compose publishes Postgres on host port 5433 (5433:5432), so a local
# (non-container) `npm run dev` must use 5433. The backend *container* is given
# its own DATABASE_URL (postgres:5432, internal) by docker-compose.
DATABASE_URL=postgres://talentmatch:talentmatch@localhost:5433/talentmatch

# --- Dev SMTP / Mailhog (README §2.5) --------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025

# --- URLs ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
PORT=8080
